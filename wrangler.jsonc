{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "our-space",
	"compatibility_date": "2026-07-05",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Diary, letters, accounts… everything the app stores (schema: d1/schema.sql)
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "our-space-db",
			"database_id": "1e2097f3-570d-4d46-92b2-fd33afb6c637"
		}
	],
	// Gallery photos + avatars. The bucket stays private; files are served
	// through /api/storage/<key>.
	"r2_buckets": [
		{
			"binding": "PHOTOS_BUCKET",
			"bucket_name": "our-space-photos"
		}
	],
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "our-space"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}
